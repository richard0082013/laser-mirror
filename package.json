{
  "name": "laser-mirror",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "build:single": "npm run build && node scripts/make-single-file.mjs",
    "gen:daily": "vite build --ssr scripts/generate-daily.ts --outDir node_modules/.cache/gen --logLevel warn && node node_modules/.cache/gen/generate-daily.js"
  },
  "devDependencies": {
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vitest": "^5.1.0"
  },
  "dependencies": {
    "@fontsource/zcool-qingke-huangyou": "^5.3.0"
  }
}
